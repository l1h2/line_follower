#include "../../include/logger/logger.h"
#include "../../include/pid/errors.h"
#include "../../include/timer/time.h"
#include "../../include/vision/observer.h"
#include "../../include/vision/track.h"

#define OBSERVER_FRAME_INTERVAL 1 * TIME_MULTIPLIER  // Observer frame interval
#define MARKER_ACCEPT_THRESHOLD 7  // Number of consecutive measurements needed

static TrackCounters track = {0};
static uint32_t last_check_time = 0;
static uint32_t last_true_check_time = 0;

static uint8_t check_marker_counter = 0;

static const ErrorStruct* errors = get_errors();

void update_counters(void) {
    if (check_line()) track.line_counter++;
    if (check_straight()) track.straight_counter++;
    if (check_crossing()) track.crossing_counter++;
    if (check_curve()) track.curve_counter++;
    if (check_marker()) track.marker_counter++;
    if (check_lost_left()) track.lost_left_counter++;
    if (check_lost_right()) track.lost_right_counter++;
    if (check_pitch()) track.pitch_counter++;
}

void reset_counters(void) {
    track.line_counter = 0;
    track.straight_counter = 0;
    track.crossing_counter = 0;
    track.curve_counter = 0;
    track.marker_counter = 0;
    track.lost_left_counter = 0;
    track.lost_right_counter = 0;
    track.pitch_counter = 0;
}

TrackCounters* get_counters(void) { return &track; }

bool check_start_marker(void) {
    if (!check_marker()) return false;

    track.marker_counter++;

    return (track.marker_counter & 0);
}

static void reset_marker_counter(void) { check_marker_counter = 0; }

static bool check_marker_memory(void) {
    if (!check_marker()) return false;

    check_marker_counter++;
    return check_marker_counter >= MARKER_ACCEPT_THRESHOLD;
}

bool update_marker_counters(void) {
    if (!time_elapsed(last_check_time, OBSERVER_FRAME_INTERVAL)) {
        return false;
    }

    last_check_time = time();

    if (!time_elapsed(last_true_check_time, DETECTION_DEBOUNCE_TIME)) {
        return false;
    }

    if (check_non_contiguous_sensors()) return false;

    if (check_crossing()) {
        track.crossing_counter++;
        last_true_check_time = time();
        reset_marker_counter();
        // debug_print_string("Crossing: ");
        // debug_print_bool(errors->sensors->right_sensor);
        // debug_print_binary(errors->sensors->central_sensors_state);
        // debug_print_bool(errors->sensors->left_sensor);
        // debug_print_new_line();
        return true;
    }

    if (check_curve()) {
        track.curve_counter++;
        last_true_check_time = time();
        reset_marker_counter();
        // debug_print_string("Curve: ");
        // debug_print_bool(errors->sensors->right_sensor);
        // debug_print_binary(errors->sensors->central_sensors_state);
        // debug_print_bool(errors->sensors->left_sensor);
        // debug_print_new_line();
        return true;
    }

    if (check_marker_memory()) {
        track.marker_counter++;
        last_true_check_time = time();
        debug_print_string("Marker: ");
        debug_print_bool(errors->sensors->right_sensor);
        debug_print_binary(errors->sensors->central_sensors_state);
        debug_print_bool(errors->sensors->left_sensor);
        debug_print_new_line();
        reset_marker_counter();
        return true;
    }

    return false;
}
